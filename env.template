# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ieee_certificates

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Blockchain Configuration
# Contract address (will be set after deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Ethereum Network URLs
MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
POLYGON_URL=https://polygon-rpc.com
MUMBAI_URL=https://rpc-mumbai.maticvigil.com
BSC_URL=https://bsc-dataseed1.binance.org
BSC_TESTNET_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Private Key for contract deployment (KEEP SECURE!)
PRIVATE_KEY=your-wallet-private-key-here

# API Keys for block explorers
ETHERSCAN_API_KEY=your-etherscan-api-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key
BSCSCAN_API_KEY=your-bscscan-api-key

# Infura Project ID
INFURA_PROJECT_ID=your-infura-project-id

# IPFS Configuration (for storing certificate files)
IPFS_PROJECT_ID=your-ipfs-project-id
IPFS_PROJECT_SECRET=your-ipfs-project-secret
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.infura.io/ipfs/

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Certificate Configuration
CERTIFICATE_TEMPLATE_PATH=./templates/default.html
DEFAULT_CERTIFICATE_VALIDITY_DAYS=365

# Blockchain Settings
GAS_LIMIT=500000
GAS_PRICE=20000000000
CONFIRMATION_BLOCKS=3

# Security Settings
BCRYPT_ROUNDS=12
TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Webhook Configuration (optional)
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=https://your-domain.com/api/webhooks

# Analytics (optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token

# Error Reporting (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Session Configuration
SESSION_SECRET=your-session-secret
SESSION_MAX_AGE=86400000

# Feature Flags
ENABLE_BLOCKCHAIN=true
ENABLE_IPFS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_BULK_OPERATIONS=true
ENABLE_API_RATE_LIMITING=true

# Monitoring
HEALTH_CHECK_INTERVAL=60000
LOG_LEVEL=info
